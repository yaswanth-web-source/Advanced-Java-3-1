import java.sql.*;
public class Main {
    public static void main(String[] args) {
        String url = "jdbc:mysql://localhost:3306/testdb";
        String user = "root";
        String password = "Yaswanth@123";

        try {
            Class.forName("com.mysql.cj.jdbc.Driver");
            Connection con = DriverManager.getConnection(url, user, password);
            Statement st = con.createStatement();
            String createTable = "CREATE TABLE GE(" +
                     "geno INT PRIMARY KEY," +
                     "gename VARCHAR(50)," +
                     "service VARCHAR(30)," +
                     "pf DOUBLE)";
              st.executeUpdate(createTable);
            System.out.println("Table Created Successfully");
            String insert = "INSERT INTO GE VALUES(?,?,?,?)";
            PreparedStatement ps = con.prepareStatement(insert);
            ps.setInt(1,101);
            ps.setString(2,"Yaswanth");
            ps.setString(3,"Manager");
            ps.setDouble(4,35000);
            ps.executeUpdate();
            ps.setInt(1, 102);
            ps.setString(2, "Pavan");
            ps.setString(3, "Sales");
            ps.setDouble(4, 20000);
            ps.executeUpdate();
            ps.setInt(1, 103);
            ps.setString(2, "Deva");
            ps.setString(3, "Bank");
            ps.setDouble(4, 30000);
            ps.executeUpdate();
            ps.setInt(1, 104);
            ps.setString(2, "Arjun");
            ps.setString(3, "Railway");
            ps.setDouble(4, 40000);
            ps.executeUpdate();
            System.out.println("4 Records Inserted Successfully");
            System.out.println("After Insertion the Records :");
            display(con);
             ps.setInt(1,105);
            ps.setString(2,"Vasu");
            ps.setString(3,"Aero");
            ps.setDouble(4,45000);
            ps.executeUpdate();

            ps.setInt(1,106);
            ps.setString(2,"Emma");
            ps.setString(3,"Designer");
            ps.setDouble(4,5000);
            ps.executeUpdate();
            System.out.println("\nAfter Inserting 2 Records");
            display(con);
            String delete="DELETE FROM GE WHERE geno=?";
            PreparedStatement psdel=con.prepareStatement(delete);
            psdel.setInt(1,105);
            psdel.executeUpdate();
             System.out.println("\nAfter Deleting One Record:");
            display(con);
            String update="UPDATE GE SET service=? WHERE geno=?";
            PreparedStatement psupd=con.prepareStatement(update);
            psupd.setString(1,"developer");
            psupd.setInt(2,106);
            psupd.executeUpdate();
            System.out.println("\nAfter Updating One Record:");
            display(con);
            con.close();
        } catch(Exception e) {
            e.printStackTrace();
        }
    }
    public static void display(Connection con) throws SQLException {

        PreparedStatement ps = con.prepareStatement("SELECT * FROM GE");
        ResultSet rs = ps.executeQuery();
        System.out.println("GENO\tGENAME\t\tSERVICE\t\tPF");
         while(rs.next()) {
            System.out.println(rs.getInt("geno") + "\t"
                    + rs.getString("gename") + "\t\t"
                    + rs.getString("service") + "\t\t"
                    + rs.getDouble("pf"));
         }
    }
}


